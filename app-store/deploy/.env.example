# Port the appstore container listens on.
APPSTORE_PORT=8097

# Public F-Droid repo URL (must end in /fdroid/repo). Required.
APPSTORE_REPO_URL=https://appstore.simon.duchastel.com/fdroid/repo

# Display name and description shown in the web UI and F-Droid index.
APPSTORE_REPO_NAME=App Store
APPSTORE_REPO_DESCRIPTION=F-Droid app store

# F-Droid signing keystore configuration. All required.
APPSTORE_KEY_ALIAS=simon-appstore
APPSTORE_KEYSTORE=/secrets/keystore.p12
APPSTORE_KEYSTORE_PASS_CMD=cat /secrets/keystorepass
APPSTORE_KEY_PASS_CMD=cat /secrets/keypass

# How often the container re-scans for new APKs.
APPSTORE_SCAN_INTERVAL=15m

# Host paths mounted into the container. Override these to match your layout.
APK_DIR=/mnt/bob-storage/code/binaries/android/apks
METADATA_DIR=/mnt/bob-storage/code/binaries/android/appstore/metadata
SECRETS_DIR=/mnt/bob-storage/code/binaries/android/appstore/secrets
FDROID_DATA_DIR=/mnt/nvme01/appstore-fdroid-data

# Docker registry source. The registry storage root is mounted read-only and
# scanned to list published images. APPSTORE_DOCKER_REGISTRY_URL is the public
# address used in docker pull commands.
DOCKER_REGISTRY_DIR=/mnt/bob-storage/code/binaries/docker/registry/docker
APPSTORE_DOCKER_REGISTRY_URL=https://registry.simon.duchastel.com

TZ=America/Los_Angeles
